# product-finder settings
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#   1. Make a copy of it in this same folder and name the copy  .env
#      Windows PowerShell:  Copy-Item .env.example .env
#      macOS / Linux:       cp .env.example .env
#   2. Open .env and paste your keys in below.
#   3. NEVER commit .env or share it. It is already in .gitignore.
#      This file (.env.example) is the safe one to share -- it has no secrets.
# ---------------------------------------------------------------------------


# === REQUIRED: Etsy ========================================================
# BOTH values come from https://www.etsy.com/developers/your-apps
# (click the eye / visibility icon to reveal the shared secret).
#
# Etsy needs both: it sends them joined as "keystring:shared_secret".
# The keystring alone is rejected with a 403.
#
# No OAuth is needed -- the listing search we use only requires this API key.
ETSY_API_KEY=paste_your_etsy_keystring_here
ETSY_SHARED_SECRET=paste_your_etsy_shared_secret_here


# === REQUIRED for sourcing/profit: AliExpress ==============================
# From your app at https://openservice.aliexpress.com (Console -> App Management)
# Without these, the tool still runs Etsy demand research (same as --etsy-only).
ALIEXPRESS_APP_KEY=paste_your_app_key_here
ALIEXPRESS_APP_SECRET=paste_your_app_secret_here

# Optional. Your affiliate tracking ID, if you have one. When set, the product
# links in the reports become your affiliate links.
ALIEXPRESS_TRACKING_ID=

# Which signing algorithm to use. Leave as sha256 unless AliExpress tells you
# your app is on the legacy scheme, in which case use: md5
ALIEXPRESS_SIGN_METHOD=sha256

# The API gateway. Leave this alone unless AliExpress gives you another one.
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync


# === Etsy fees used for the profit maths ===================================
# These are the defaults for a standard US shop. Etsy changes its fees and they
# differ by country, so check your own fee page and update these.
# Written as decimals: 0.065 means 6.5%.
ETSY_TRANSACTION_RATE=0.065
ETSY_PAYMENT_RATE=0.03
ETSY_PAYMENT_FLAT=0.25
ETSY_LISTING_FEE=0.20

# Offsite Ads (12% or 15%) only applies to sales that come through an Etsy ad,
# so it is off by default. Set to 0.15 to see a pessimistic worst case.
ETSY_OFFSITE_ADS_RATE=0.0

# What you plan to charge buyers for shipping. 0 = free shipping (most common
# on Etsy, and the shipping cost then comes out of your margin).
ETSY_SHIPPING_CHARGED=0.0


# === Sourcing assumptions ==================================================
# The AliExpress affiliate endpoint usually does not report shipping cost.
# When it does not, we assume this much per item, and mark the row with a ~
ASSUMED_SHIPPING=2.50


# === Scoring dials =========================================================
# These turn raw Etsy numbers into the 0-100 scores. They are judgement calls,
# not facts, and the right values depend on your category. The defaults were
# calibrated against real craft-supply searches, where a popular keyword
# averages HUNDREDS of favourites per listing -- far more than you might guess.
#
# Demand: this many average favourites or fewer scores 0, this many or more
# scores 100. Raise the high value if everything you search scores 100.
DEMAND_FAVORITES_LOW=10
DEMAND_FAVORITES_HIGH=2000

# Competition: this many competing listings or fewer scores 100 for
# low-competition; this many or more scores 0.
COMPETITION_LISTINGS_LOW=200
COMPETITION_LISTINGS_HIGH=50000

# Flag thresholds. A keyword under LOW_COMPETITION_LISTINGS *and* at or above
# HIGH_FAVORITES_AVERAGE earns the "LOW COMPETITION + HIGH FAVORITES" flag.
LOW_COMPETITION_LISTINGS=2500
HIGH_FAVORITES_AVERAGE=150
SATURATED_LISTINGS=10000


# === How much data to pull ==================================================
ETSY_LIMIT=100          # Etsy listings per keyword (max 100)
ALIEXPRESS_LIMIT=40     # AliExpress products per keyword (max 50)
CURRENCY=USD
SHIP_TO_COUNTRY=US


# === Local files ===========================================================
CACHE_TTL_HOURS=24      # reuse saved API responses for this long
# CACHE_DIR=.cache
# OUTPUT_DIR=reports
